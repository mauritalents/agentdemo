rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque utilisateur (même anonyme) ne lit et n'écrit que ses propres conversations.
    match /users/{uid}/conversations/{convId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['provider', 'model', 'startedAt', 'updatedAt']);
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /messages/{msgId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['role', 'content', 'model', 'createdAt', 'idx'])
          && request.resource.data.role in ['user', 'assistant']
          && request.resource.data.content is string
          && request.resource.data.content.size() < 100000;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Tout le reste est interdit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
